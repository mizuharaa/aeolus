# Rendered by terraform into /opt/olus/docker-compose.yml. Do not edit on the
# box; edit infra/aws/templates/docker-compose.yml.tftpl and re-apply.
#
# Unlike the repo-root docker-compose.yml this file builds nothing and mounts no
# source: the image comes from ECR, and the only bind mount is the SQLite state
# dir. The Next.js site is on Vercel, so the API is the only service here.
services:
  api:
    image: ${api_image}
    container_name: olus-api
    restart: unless-stopped
    ports:
      - "8000:8000"
    environment:
      APP_ENV: production
      LOG_LEVEL: INFO
      CORS_ORIGINS: ${cors_origins}
      # OpenSky blocks every cloud IP (Vercel and AWS both), so live traffic
      # comes from the community ADS-B feeds: adsb.lol, adsb.fi as fallback.
      ADSB_PROVIDER: adsblol
    volumes:
      # Survives a container replacement; snapshotted nightly by DLM and copied
      # to S3 by /etc/cron.daily/olus-backup.
      - /opt/olus/state:/app/apps/api/state
    logging:
      driver: awslogs
      options:
        awslogs-region: ${region}
        awslogs-group: ${log_group}
        awslogs-stream: api
